# Local Development Environment Configuration
#
# This file is used by compose.yml for local development.
# Metabase connects to the local postgres service.
#
# To use, copy to .env and fill in the values.
# cp .env.example .env

# PostgreSQL service credentials
POSTGRES_USER="metabase"
POSTGRES_PASSWORD="metabase"
POSTGRES_DB="metabase"

# Metabase database connection
MB_DB_TYPE="postgres"
MB_DB_HOST="postgres"
MB_DB_DBNAME="metabase"
MB_DB_USER="metabase"
MB_DB_PASS="metabase"

# Metabase Encryption Secret (at least 32 characters)
MB_ENCRYPTION_SECRET_KEY="change-this-to-a-random-32-character-string"

# Metabase Session Secret Key (at least 32 characters)
MB_SESSION_SECRET_KEY="change-this-to-a-random-32-character-string"

# Metabase Admin User (created on first boot)
MB_ADMIN_EMAIL="admin@localhost"
MB_ADMIN_PASSWORD="admin"
MB_ADMIN_FIRST_NAME="Admin"
MB_ADMIN_LAST_NAME="User"

# Metabase JVM tuning
JAVA_OPTS="-Xmx1024m -Xms512m -Djava.net.preferIPv4Stack=true -Djava.net.useSystemProxies=false"

# Google Sign-In
MB_GOOGLE_AUTH_ENABLED="true"
MB_GOOGLE_AUTH_CLIENT_ID=""
MB_GOOGLE_AUTH_AUTO_CREATE_ACCOUNTS_DOMAIN="compiler.la"
MB_ENABLE_PASSWORD_LOGIN="true"
# Reuse env for terraform
TF_VAR_google_client_id="${MB_GOOGLE_AUTH_CLIENT_ID}"

# SMTP (Google Workspace via smtp.gmail.com)
MB_EMAIL_SMTP_HOST="smtp.gmail.com"
MB_EMAIL_SMTP_PORT="465"
MB_EMAIL_SMTP_SECURITY="ssl"
MB_EMAIL_SMTP_USERNAME="bot@compiler.la"
MB_EMAIL_SMTP_PASSWORD=""
# Reuse env for terraform
TF_VAR_smtp_password="${MB_EMAIL_SMTP_PASSWORD}"

# Dev container helpers
METABASE_URL="http://metabase:3000"
