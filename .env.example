# Local Development Environment Configuration
POSTGRES_USER="metabase"
POSTGRES_PASSWORD="metabase"
POSTGRES_DB="metabase"

# Metabase Encryption Secret (at least 32 characters)
MB_ENCRYPTION_SECRET_KEY="local_dev_secret_key_32_characters_minimum_len"

# CloudFlare (CF_API_TOKEN is used by the Terraform Cloudflare provider)
CF_API_TOKEN="your_cloudflare_api_token_here"
