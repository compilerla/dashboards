# Local Development Environment Configuration
POSTGRES_USER="metabase"
POSTGRES_PASSWORD="metabase"
POSTGRES_DB="metabase"

# Metabase Encryption Secret (at least 32 characters)
MB_ENCRYPTION_SECRET_KEY="local_dev_secret_key_32_characters_minimum_len"

# Metabase Session Secret Key (signs stored session-key hashes, at least 32 characters)
MB_SESSION_SECRET_KEY="local_dev_session_secret_key_32_characters_minimum_len"

# Metabase Admin User (created on first boot)
MB_ADMIN_EMAIL="admin@localhost"
MB_ADMIN_PASSWORD="admin"
MB_ADMIN_FIRST_NAME="Admin"
MB_ADMIN_LAST_NAME="User"

# Metabase JVM tuning
JAVA_OPTS="-Xmx1024m -Xms512m -Djava.net.preferIPv4Stack=true -Djava.net.useSystemProxies=false"

# Metabase database connection (local dev uses TCP, not Unix socket)
MB_DB_TYPE="postgres"
MB_DB_HOST="127.0.0.1"
MB_DB_PORT="5432"
MB_DB_JDBC_PARAMS="sslmode=disable&ssl=false&socketTimeout=60"
MB_DB_DBNAME="metabase"

# Dev container helpers
METABASE_URL="http://metabase:3000"
